generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id        String            @id @default(cuid())
  company   String
  position  String
  url       String?
  location  String?
  salary    String?
  status    ApplicationStatus @default(SAVED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([createdAt])
}
